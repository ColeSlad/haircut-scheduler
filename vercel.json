{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["iad1"],
  "functions": { "api/index.js": { "maxDuration": 60 } },
  "crons": [{ "path": "/api/cron/payments", "schedule": "0 8 * * *" }],
  "redirects": [{ "source": "/:path*", "has": [{ "type": "host", "value": "l2cuts.com" }], "destination": "https://www.l2cuts.com/:path*", "permanent": true }],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/schedule", "destination": "/index.html" },
    { "source": "/gallery", "destination": "/index.html" },
    { "source": "/booking", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https://images.unsplash.com https://*.public.blob.vercel-storage.com blob: data:; media-src 'self' https://*.public.blob.vercel-storage.com; connect-src 'self' https://blob.vercel-storage.com https://*.blob.vercel-storage.com; font-src 'self'; frame-src https://www.tiktok.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" }
    ] },
    { "source": "/(admin|booking)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }, { "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/api/:path*", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
