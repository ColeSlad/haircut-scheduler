PORT=3000
HOST=127.0.0.1
# Set this to the exact public HTTPS URL before deployment.
APP_ORIGIN=http://localhost:3000
# Set NODE_ENV=production behind an HTTPS reverse proxy.
NODE_ENV=development
# DATA_DIR=./data

# Admin SMS sign-in (Twilio Verify). Keep these values private.
# ADMIN_PHONE uses the country code, for example +15551234567.
ADMIN_PHONE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
