PORT=3000
HOST=127.0.0.1
# Deployed demo: https://l2cuts.vercel.app; custom domain: https://www.l2cuts.com.
# Use the exact browser origin, without a trailing slash.
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
# Use a dedicated local database; never point tests at production.
DATABASE_URL=postgres://localhost:5432/haircut
TEST_DATABASE_URL=postgres://localhost:5432/haircut_test
# Direct/non-pooler URL for migrations, imports and backups. Optional locally.
DATABASE_URL_DIRECT=
# Generate each secret independently: openssl rand -hex 32
APP_SECRET=
CRON_SECRET=
# Use test-mode keys locally and on preview deployments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional barber SMS alerts. Use a Twilio sender number OR Messaging Service.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
BLOB_READ_WRITE_TOKEN=
# Exact public store origin, without trailing slash.
BLOB_PUBLIC_ORIGIN=
# DATA_DIR is used only when importing the original SQLite database/media.
# DATA_DIR=./data
