{
  "name": "haircut-scheduler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A single-barber booking website with a private admin workspace.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.js",
    "build": "node scripts/build.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "db:import": "node --env-file-if-exists=.env scripts/import-sqlite.js",
    "preflight": "node --env-file-if-exists=.env scripts/preflight.js",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.3",
    "pg": "^8.23.1",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
